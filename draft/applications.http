### Variables
@baseUrl = http://localhost:5080
@token = {{loginCookie.response.headers.Set-Cookie}}

### ============================================================
### OPENIDDICT APPLICATIONS API (MasterAdminOnly)
### ============================================================

### List all applications — paged + search (QUERY — new, secrets masked sk-****xyz)
QUERY {{baseUrl}}/api/applications/
Content-Type: application/json
Cookie: {{token}}

{
  "searchTerm": "Admin",
  "pageNumber": 1,
  "pageSize": 20
}

### Get application by client ID (secret masked if confidential)
GET {{baseUrl}}/api/applications/OroIdentityServer.Admin
Cookie: {{token}}

### Create a new application (public client - SPA)
POST {{baseUrl}}/api/applications/
Content-Type: application/json
Cookie: {{token}}

{
    "clientId": "my-spa-client",
    "clientSecret": null,
    "displayName": "My SPA Client",
    "clientType": "public",
    "applicationType": "web",
    "consentType": "explicit",
    "permissions": [
        "ept:authorization",
        "ept:token",
        "ept:end_session",
        "ept:userinfo",
        "gt:authorization_code",
        "gt:refresh_token",
        "rst:code",
        "scp:openid",
        "scp:profile",
        "scp:email",
        "scp:roles",
        "scp:offline_access"
    ],
    "requirements": ["ft:pkce"],
    "redirectUris": ["http://localhost:4200/callback"],
    "postLogoutRedirectUris": ["http://localhost:4200"]
}

### Create a new confidential application — auto-generates secret if empty (sk- returned once)
POST {{baseUrl}}/api/applications/
Content-Type: application/json
Cookie: {{token}}

{
    "clientId": "my-api-client",
    "clientSecret": null,
    "displayName": "My API Client",
    "clientType": "confidential",
    "applicationType": "web",
    "consentType": "implicit",
    "permissions": [
        "ept:token",
        "gt:client_credentials",
        "scp:admin"
    ],
    "requirements": [],
    "redirectUris": [],
    "postLogoutRedirectUris": []
}

### Create confidential with explicit secret
POST {{baseUrl}}/api/applications/
Content-Type: application/json
Cookie: {{token}}

{
    "clientId": "my-api-client-2",
    "clientSecret": "super-secret-key-change-me",
    "displayName": "My API Client 2",
    "clientType": "confidential",
    "applicationType": "web",
    "consentType": "implicit",
    "permissions": ["ept:token", "gt:client_credentials", "scp:admin"],
    "requirements": [],
    "redirectUris": [],
    "postLogoutRedirectUris": []
}

### Update an application (leave clientSecret empty to keep existing)
PUT {{baseUrl}}/api/applications/my-spa-client
Content-Type: application/json
Cookie: {{token}}

{
    "clientId": "my-spa-client",
    "clientSecret": null,
    "displayName": "Updated SPA Client",
    "clientType": "public",
    "applicationType": "web",
    "consentType": "explicit",
    "permissions": ["ept:authorization", "ept:token", "ept:end_session"],
    "requirements": ["ft:pkce"],
    "redirectUris": ["http://localhost:4200/callback", "http://localhost:3000/callback"],
    "postLogoutRedirectUris": ["http://localhost:4200", "http://localhost:3000"]
}

### Delete an application
DELETE {{baseUrl}}/api/applications/my-spa-client
Cookie: {{token}}
