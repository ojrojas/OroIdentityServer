{
  "name": "oroidentity-admin",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node change_environment.js && ng serve --configuration ${NG_CONFIG:-development} --port ${NG_PORT:-4200}",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "start:explicit": "ENV_TARGET=environment.development.explicit.ts NG_CONFIG=development-explicit NG_PORT=4201 CLIENT_ID=OroIdentityServer.Admin.Explicit node change_environment.js && ng serve --configuration development-explicit --port 4201"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.25",
    "@angular/compiler": "^21.2.25",
    "@angular/core": "^21.2.25",
    "@angular/forms": "^21.2.25",
    "@angular/platform-browser": "^21.2.25",
    "@angular/router": "^21.2.25",
    "@microsoft/signalr": "^10.0.11",
    "@ngrx/signals": "^21.1.1",
    "@ngx-translate/core": "^17.0.0",
    "@ngx-translate/http-loader": "^17.0.0",
    "angular-auth-oidc-client": "^21.0.4",
    "marked": "^18.1.1",
    "ngx-markdown": "^21.3.0",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.25",
    "jsdom": "^28.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "vitest": "^4.1.12"
  }
}
