@page "/"
@using System.Security.Claims

<PageTitle>Home</PageTitle>

<h1>Blazor Server Session Example</h1>

@if (User?.Identity?.IsAuthenticated == true)
{
    <p>Welcome, <strong>@User.FindFirstValue(ClaimTypes.Name)</strong>!</p>
    <p>Your session is being monitored via introspection.</p>
    <p>If an admin revokes your session, you will be redirected to login automatically.</p>
}
else
{
    <p>You are not logged in.</p>
    <a href="/Account/Login">Login with Identity Server</a>
}

@code {
    [CascadingParameter]
    private ClaimsPrincipal? User { get; set; }
}
