@* Inline SVG icon set. Stroke-based, inherits currentColor. *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round"
     class="@Class" aria-hidden="true" focusable="false">
    @switch (Name)
    {
        case "dashboard":
            <rect x="3" y="3" width="7" height="7" rx="2" />
            <rect x="14" y="3" width="7" height="7" rx="2" />
            <rect x="3" y="14" width="7" height="7" rx="2" />
            <rect x="14" y="14" width="7" height="7" rx="2" />
            break;

        case "users":
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87" />
            break;

        case "user":
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
            break;

        case "shield":
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
            break;

        case "document":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
            break;

        case "apps":
            <rect x="3" y="3" width="18" height="18" rx="3" />
            <path d="M3 9h18M9 21V9" />
            break;

        case "key":
            <circle cx="7.5" cy="15.5" r="4.5" />
            <path d="m10.5 12.5 8-8M17 5l3 3M14.5 8.5l2.5 2.5" />
            break;

        case "plug":
            <path d="M12 22v-5M9 7V2M15 7V2M6 13V8h12v5a6 6 0 0 1-12 0z" />
            break;

        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;

        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
            break;

        case "bell":
            <path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9" />
            <path d="M13.7 21a2 2 0 0 1-3.4 0" />
            break;

        case "moon":
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
            break;

        case "sun":
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
            break;

        case "edit":
            <path d="M11 4H4v16h16v-7" />
            <path d="M18.5 2.5a2.1 2.1 0 0 1 3 3L12 15l-4 1 1-4z" />
            break;

        case "trash":
            <path d="M3 6h18M8 6V4h8v2M19 6l-1 14H6L5 6" />
            break;

        case "lock":
            <rect x="4" y="11" width="16" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            break;

        case "unlock":
            <rect x="4" y="11" width="16" height="10" rx="2" />
            <path d="M8 11V7a4 4 0 0 1 7.5-2" />
            break;

        case "disconnect":
            <path d="M9 2v5M15 2v5M6 12V7h12v5a6 6 0 0 1-3 5.2" />
            <path d="m3 3 18 18" />
            break;

        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;

        case "check-circle":
            <circle cx="12" cy="12" r="10" />
            <path d="m8 12 3 3 5-6" />
            break;

        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;

        case "x-circle":
            <circle cx="12" cy="12" r="10" />
            <path d="m15 9-6 6M9 9l6 6" />
            break;

        case "alert":
            <path d="M12 9v4M12 17h.01" />
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            break;

        case "info":
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4M12 8h.01" />
            break;

        case "chevron-down":
            <polyline points="6 9 12 15 18 9" />
            break;

        case "arrow-right":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;

        case "arrow-left":
            <path d="M19 12H5M11 18l-6-6 6-6" />
            break;

        case "arrow-up":
            <path d="M12 19V5M5 12l7-7 7 7" />
            break;

        case "arrow-down":
            <path d="M12 5v14M19 12l-7 7-7-7" />
            break;

        case "logout":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="m16 17 5-5-5-5M21 12H9" />
            break;

        case "menu":
            <path d="M3 6h18M3 12h18M3 18h18" />
            break;

        case "chat":
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
            break;

        case "clock":
            <circle cx="12" cy="12" r="10" />
            <path d="M12 6v6l4 2" />
            break;

        case "globe":
            <circle cx="12" cy="12" r="10" />
            <path d="M2 12h20M12 2a15 15 0 0 1 0 20 15 15 0 0 1 0-20z" />
            break;

        case "refresh":
            <path d="M21 12a9 9 0 0 1-9 9 9 9 0 0 1-7.4-3.9M3 12a9 9 0 0 1 9-9 9 9 0 0 1 7.4 3.9" />
            <path d="M21 3v5h-5M3 21v-5h5" />
            break;

        case "save":
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
            <path d="M17 21v-8H7v8M7 3v5h8" />
            break;

        default:
            <circle cx="12" cy="12" r="9" />
            break;
    }
</svg>

@code {
    /// <summary>Icon name from the set above.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    [Parameter] public int Size { get; set; } = 18;

    [Parameter] public double Stroke { get; set; } = 1.7;

    [Parameter] public string? Class { get; set; }
}
