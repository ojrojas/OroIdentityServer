@inject NavigationManager Nav

<select class="select @Class" value="@selectedCulture"
        @onchange="e => ChangeCulture(e.Value?.ToString())"
        aria-label="@AriaLabel">
    @* NB: don't name the loop variable "code" - Razor parses a leading @code as the directive. *@
    @foreach (var lang in Languages)
    {
        <option value="@lang.Code" selected="@(lang.Code == selectedCulture)">@lang.Label</option>
    }
</select>

@code {
    [Parameter] public string Class { get; set; } = string.Empty;

    [Parameter] public string AriaLabel { get; set; } = "Language";

    private string? selectedCulture;

    private static readonly (string Code, string Label)[] Languages =
    [
        ("en", "English"),
        ("es", "Español"),
        ("fr", "Français"),
        ("it", "Italiano"),
        ("de", "Deutsch"),
        ("br", "Português (Brasil)"),
        ("ja", "日本語"),
        ("zh", "中文（简体）")
    ];

    protected override void OnInitialized() => selectedCulture = CultureInfo.CurrentUICulture.Name;

    private void ChangeCulture(string? culture)
    {
        if (string.IsNullOrEmpty(culture) || culture == CultureInfo.CurrentUICulture.Name)
            return;

        var uri = Nav.ToAbsoluteUri(Nav.Uri).PathAndQuery;
        Nav.NavigateTo($"/culture/set?culture={culture}&redirectUri={Uri.EscapeDataString(uri)}", forceLoad: true);
    }
}
