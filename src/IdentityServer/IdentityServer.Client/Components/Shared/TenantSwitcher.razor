@using System.Security.Claims
@inject IAdminTenantService TenantService
@inject ICurrentTenantContext TenantContext
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<div class="tenant-switcher">
    @if (loading)
    {
        <div class="tenant-switcher-label">@L["CurrentTenant"]…</div>
    }
    else
    {
        <label class="tenant-switcher-label" for="tenant-switcher">@L["CurrentTenant"]</label>
        <div class="tenant-switcher-row">
            <select id="tenant-switcher" class="tenant-switcher-select" value="@SelectedTenantId" @onchange="OnTenantChanged">
                @foreach (var tenant in TenantContext.Tenants)
                {
                    <option value="@tenant.Id">@tenant.Name</option>
                }
            </select>
            <AuthorizeView Roles="Admin">
                <Authorized>
                    <button type="button" class="tenant-switcher-add" title="@L["AddTenant"]" @onclick="AddTenant">
                        <Icon Name="plus" Size="14" Stroke="2.4" />
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>
    }
</div>

@code {
    private bool loading = true;
    private bool loaded;

    private string SelectedTenantId => TenantContext.CurrentTenantId?.ToString() ?? string.Empty;

    protected override Task OnInitializedAsync()
    {
        // Nothing async here: the tenant list is loaded on the interactive pass in
        // OnAfterRenderAsync, never during static SSR (whose request scope can be torn
        // down while the query runs, disposing the pooled DbContext).
        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Only the interactive pass (WASM / InteractiveServer) can call JS. During static SSR
        // this throws, which tells us to skip the tenant query altogether.
        string? stored;
        try
        {
            stored = await JS.InvokeAsync<string>("oroTenant.current");
        }
        catch (Exception)
        {
            return; // static SSR - skip
        }

        if (!loaded)
        {
            loaded = true;

            var tenants = await LoadTenantsAsync();

            // Prefer the persisted selection (server middleware reads the oro_tenant cookie),
            // then the logged-in user's own tenant (tenant_id claim), then the first one.
            var current = TenantContext.CurrentTenantId
                ?? await GetHomeTenantIdAsync()
                ?? tenants.FirstOrDefault()?.Id;

            TenantContext.Initialize(tenants, current);
            loading = false;
        }

        if (Guid.TryParse(stored, out var storedId) && TenantContext.HasTenant(storedId))
        {
            TenantContext.SetCurrentTenantId(storedId);
        }

        StateHasChanged();
    }

    private async Task<List<TenantModel>> LoadTenantsAsync()
    {
        if (OperatingSystem.IsBrowser())
        {
            // Master admins can see every tenant; the server already filters the response for
            // tenant admins. If that round-trip fails, fall back to the claims-based lookup.
            try
            {
                var mine = await TenantService.GetMyTenantsAsync();
                var mineTenants = mine?.Data?.ToList();
                if (mineTenants is { Count: > 0 })
                    return mineTenants;
            }
            catch
            {
                // fall through to the claims-based lookup
            }
        }

        // Resolve the user from the claims (works on every pass: WASM, prerender, InteractiveServer).
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdClaim = authState.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;

        if (Guid.TryParse(userIdClaim, out var userId))
        {
            // ManagerOrAdmin endpoint: a Member gets a 403 here, so fall back to an empty list
            // rather than crashing the tenant switcher (and with it the whole layout).
            try
            {
                var response = await TenantService.GetTenantsByUserIdAsync(userId);
                return response?.Data?.ToList() ?? [];
            }
            catch
            {
                return [];
            }
        }

        return [];
    }

    private async Task<Guid?> GetHomeTenantIdAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var tenantClaim = authState.User.FindFirst("tenant_id")?.Value;
        return Guid.TryParse(tenantClaim, out var id) ? id : null;
    }

    private async Task OnTenantChanged(ChangeEventArgs e)
    {
        if (!Guid.TryParse(e.Value?.ToString(), out var tenantId) || !TenantContext.HasTenant(tenantId))
            return;

        TenantContext.SetCurrentTenantId(tenantId);
        await JS.InvokeVoidAsync("oroTenant.set", tenantId.ToString());
        Nav.NavigateTo(Nav.Uri, forceLoad: true);
    }

    private void AddTenant() => Nav.NavigateTo("/tenants/create");
}
