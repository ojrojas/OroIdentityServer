@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResources> L
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ICurrentTenantContext TenantContext
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<div class="app">
    <div class="shell">

        <aside class="sidebar @(sidebarOpen ? "open" : "")">
            <div class="brand">
                <span class="brand-mark"><Icon Name="shield" Size="18" Stroke="1.8" /></span>
                OroIdentity
            </div>

            <TenantSwitcher />

            <nav class="nav">
                <a class="nav-item @Active("/")" href="/" @onclick="CloseSidebar">
                    <Icon Name="dashboard" Size="19" />
                    @L["NavDashboard"]
                </a>

                <div class="nav-section">@L["NavUsers"]</div>
                <a class="nav-item @Active("/users")" href="/users" @onclick="CloseSidebar">
                    <Icon Name="users" Size="19" />
                    @L["NavUsers"]
                </a>
                <AuthorizeView Roles="Admin,Administrator,Manager">
                    <Authorized>
                        <a class="nav-item @Active("/roles")" href="/roles" @onclick="CloseSidebar">
                            <Icon Name="shield" Size="19" />
                            @L["NavRoles"]
                        </a>
                    </Authorized>
                </AuthorizeView>
                <a class="nav-item @Active("/identification-types")" href="/identification-types" @onclick="CloseSidebar">
                    <Icon Name="document" Size="19" />
                    @L["NavIdentificationTypes"]
                </a>

                @* OIDC section (applications, scopes, tenants): master-admin only.
                   The page-level [Authorize] on the corresponding pages is enough to keep
                   non-master-admins out, but we hide the links too so the nav doesn't tease
                   pages that would 403 on entry. *@
                @if (isMasterAdmin)
                {
                    <div class="nav-section">@L["NavApplications"]</div>
                    <a class="nav-item @Active("/applications")" href="/applications" @onclick="CloseSidebar">
                        <Icon Name="apps" Size="19" />
                        @L["NavApplications"]
                    </a>
                    <a class="nav-item @Active("/scopes")" href="/scopes" @onclick="CloseSidebar">
                        <Icon Name="key" Size="19" />
                        @L["NavScopes"]
                    </a>
                    <a class="nav-item @Active("/tenants")" href="/tenants" @onclick="CloseSidebar">
                        <Icon Name="house" Size="19" />
                        @L["NavTenants"]
                    </a>
                }
                <a class="nav-item @Active("/sessions")" href="/sessions" @onclick="CloseSidebar">
                    <Icon Name="plug" Size="19" />
                    @L["NavSessions"]
                </a>
                <AuthorizeView Roles="Admin,Administrator,Manager">
                    <Authorized>
                        <a class="nav-item @Active("/hierarchy/manage")" href="/hierarchy/manage" @onclick="CloseSidebar">
                            <Icon Name="users" Size="19" />
                            @L["NavHierarchy"]
                        </a>
                    </Authorized>
                </AuthorizeView>
            </nav>

            <div class="rail">
                <button type="button" class="rail-btn" title="@L["ToggleTheme"]" @onclick="ToggleThemeAsync">
                    <Icon Name="@(isDark ? "sun" : "moon")" Size="17" />
                </button>
                <a class="rail-btn" href="/Account/Logout" title="@L["SignOutTitle"]">
                    <Icon Name="logout" Size="17" />
                </a>
            </div>
        </aside>

        @if (sidebarOpen)
        {
            <div class="scrim" @onclick="CloseSidebar"></div>
        }

        <div class="main">
            <header class="topbar">
                <button type="button" class="btn-icon sidebar-toggle" title="@L["ToggleMenu"]" @onclick="ToggleSidebar">
                    <Icon Name="menu" Size="18" />
                </button>

                <h1 class="page-title">@PageTitle</h1>

                <div class="search">
                    <Icon Name="search" Size="16" Stroke="2" />
                    <input placeholder="@L["SearchPlaceholder"]" @bind="search" @bind:event="oninput" @onkeydown="SearchKeyDown" />
                </div>

                <AuthorizeView>
                    <Authorized>
                        <span class="avatar avatar-c1" title="@context.User.Identity?.Name">
                            @Initials(context.User.Identity?.Name)
                        </span>
                    </Authorized>
                </AuthorizeView>
            </header>

            <div class="content">
                @Body
            </div>
        </div>
    </div>
</div>

<ToastHost />
<DialogHost />

<div id="blazor-error-ui" data-nosnippet>
    @L["UnhandledError"]
    <a href="." class="reload">@L["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool sidebarOpen;
    private bool isDark = true;
    private string search = string.Empty;

    /// <summary>Set by pages through <c>CascadingValue</c>-free convention: derived from the route.</summary>
    private string PageTitle => Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/') switch
    {
        "" => L["NavDashboard"],
        var p when p.StartsWith("users") => L["NavUsers"],
        var p when p.StartsWith("roles") => L["NavRoles"],
        var p when p.StartsWith("identification-types") => L["NavIdentificationTypes"],
        var p when p.StartsWith("applications") => L["NavApplications"],
        var p when p.StartsWith("scopes") => L["NavScopes"],
        var p when p.StartsWith("tenants/create") => L["NewTenantTitle"],
        var p when p.StartsWith("tenants") => L["NavTenants"],
        var p when p.StartsWith("sessions") => L["NavSessions"],
        var p when p.StartsWith("hierarchy") => L["NavHierarchy"],
        _ => L["NavDashboard"]
    };

    // Master-admin flag drives the OIDC nav section (Applications, Scopes, Tenants).
    // It is set in OnInitializedAsync from the is_master_admin claim that
    // AdminPasswordSignInService writes into the cookie, so it is available on
    // both the server prerender and the interactive WASM pass.
    private bool isMasterAdmin;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // The WASM client's serialized AuthenticationState only carries the identity's Name
        // and Role claims (AddAuthenticationStateDeserialization drops custom claims like
        // is_master_admin), so the master admin must be detected via the "Admin" role claim,
        // which AdminPasswordSignInService issues only to the master admin.
        isMasterAdmin = authState.User.IsInRole("Admin") || authState.User.IsInRole("Administrator");
        TenantContext.SetMasterAdmin(isMasterAdmin);

        Nav.LocationChanged += HandleLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            var theme = await JS.InvokeAsync<string>("oroTheme.current");
            isDark = theme == "dark";
            StateHasChanged();
        }
        catch (JSException) { /* prerender - resolved on the interactive pass */ }
    }

    private async Task ToggleThemeAsync()
    {
        var theme = await JS.InvokeAsync<string>("oroTheme.toggle");
        isDark = theme == "dark";
    }

    private void ToggleSidebar() => sidebarOpen = !sidebarOpen;
    private void CloseSidebar() => sidebarOpen = false;

    private void SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(search)) return;

        Nav.NavigateTo($"/users?q={Uri.EscapeDataString(search)}");
        search = string.Empty;
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        sidebarOpen = false;
        StateHasChanged();
    }

    private string Active(string href)
    {
        var path = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].TrimEnd('/');

        return href == "/"
            ? (path == "/" ? "active" : "")
            : (path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? "active" : "");
    }

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Split([' ', '.', '@'], StringSplitOptions.RemoveEmptyEntries);

        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[1][..1]).ToUpperInvariant()
        };
    }

    public void Dispose() => Nav.LocationChanged -= HandleLocationChanged;
}
