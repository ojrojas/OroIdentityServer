@page "/roles"
@attribute [Authorize(Roles = "Admin")]
@inject IAdminRoleService RoleService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["RolesTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["RolesTitle"]</h2>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync">
            <Icon Name="plus" Size="15" Stroke="2.2" /> @L["New"]
        </button>
    </div>

    @if (items is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else if (items.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">@L["NoData"]</p>
            <p>@L["NoDataHint"]</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["Name"]</th>
                        <th>@L["Active"]</th>
                        <th class="num">@L["ColPermissions"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="cell-strong">@item.Name</td>
                            <td>
                                @if (item.IsActive)
                                {
                                    <span class="badge badge-green">@L["ActiveStatus"]</span>
                                }
                                else
                                {
                                    <span class="cell-muted">—</span>
                                }
                            </td>
                            <td class="num">@(item.Claims == null ? 0 : item.Claims.Count())</td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn-row" title="@L["Edit"]" @onclick="@(() => Nav.NavigateTo($"/roles/{item.Id}"))">
                                        <Icon Name="edit" Size="15" />
                                    </button>
                                    <button type="button" class="btn-row is-danger" title="@L["Delete"]" @onclick="@(() => DeleteAsync(item))">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<RoleModel>? items;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var response = await RoleService.GetRolesAsync();
        items = response?.Data?.ToList() ?? [];
    }

    private void CreateAsync() => Nav.NavigateTo("/roles/create");

    private async Task DeleteAsync(RoleModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteRoleConfirm", item.Name ?? string.Empty],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await RoleService.DeleteRoleAsync(item.Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["RoleDeletedToast"]);
            await LoadAsync();
        }
        else if ((int)response.StatusCode == 409)
        {
            ToastService.ShowError(L["RoleDeleteConflictToast"]);
        }
        else
        {
            ToastService.ShowError(L["RoleDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
