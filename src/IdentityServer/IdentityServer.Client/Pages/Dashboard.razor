@page "/"
@attribute [Authorize(Roles = "Admin,Administrator,Manager")]
@using IdentityServer.Client.Models.Dashboard
@inject IAdminDashboardService DashboardService
@inject IAdminUserService UserService
@inject IAdminRoleService RoleService
@inject IAdminScopeService ScopeService
@inject IAdminApplicationService ApplicationService
@inject IAdminUserSessionService UserSessionService
@inject IAdminIdentificationTypeService IdentificationTypeService
@inject IAdminValidationLogService ValidationLogService
@inject IAdminTenantService TenantService
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject IStringLocalizer<SharedResources> L
@inject ICurrentTenantContext TenantContext
@rendermode InteractiveAuto


<PageTitle>@L["DashboardTitle"]</PageTitle>

<div class="dash-grid">

    @* ─────────── left column ─────────── *@
    <div class="dash-col">

        <section class="card">
            <div class="card-head">
                <h2 class="card-title">@L["OverviewTitle"]</h2>
            </div>

            <div class="inset">
                <div class="stat-row">
                    @if (isMasterAdmin)
                    {
                        <StatCard Title="@L["StatTenants"]" Value="@tenantCount" IconName="house" Featured="true"
                                  Note="@L["StatTenantsNote"]" Delta="@(stats?.TenantsCreatedToday ?? 0)"
                                  DeltaText="@DeltaText(stats?.TenantsCreatedToday ?? 0)"
                                  OnClick="@((e) => NavigationStat("/tenants"))" />
                    }
                    <StatCard Title="@L["StatUsers"]" Value="@userCount" IconName="users" Featured="true"
                              Note="@L["StatUsersNote"]" Delta="@(stats?.UsersCreatedToday ?? 0)"
                              DeltaText="@DeltaText(stats?.UsersCreatedToday ?? 0)"
                              OnClick="@((e) => NavigationStat("/users"))" />

                </div>

                <div class="stat-row" style="margin-top:4px">
                    <StatCard Title="@L["StatConnectedUsers"]" Featured="true" Value="@connectedUserCount"
                              IconName="plug" Note="@L["StatConnectedNote"]"
                              OnClick="@((e) => NavigationStat("/sessions"))" />
                    @if (isMasterAdmin)
                    {
                        <StatCard Featured="true" Title="@L["StatRoles"]" Value="@roleCount" IconName="shield"
                                  Note="@L["StatRolesNote"]" Delta="@(stats?.RolesCreatedToday ?? 0)"
                                  DeltaText="@DeltaText(stats?.RolesCreatedToday ?? 0)"
                                  OnClick="@(() => NavigationStat("/roles"))" />
                        <StatCard Featured="true" Title="@L["StatApplications"]" Value="@applicationCount" IconName="apps"
                                  Note="@L["StatApplicationsNote"]"
                                  OnClick="@(() => NavigationStat("/applications"))" />
                        <StatCard Featured="true" Title="@L["StatScopes"]" Value="@scopeCount" IconName="key"
                                  Note="@L["StatScopesNote"]"
                                  OnClick="@(() => NavigationStat("/scopes"))" />
                    }
                    <StatCard Featured="true" Title="@L["NavIdentificationTypes"]" Value="@identificationTypeCount"
                              IconName="document" Note="@L["StatIdentificationTypesNote"]"
                              Delta="@(stats?.IdentificationTypesCreatedToday ?? 0)"
                              DeltaText="@DeltaText(stats?.IdentificationTypesCreatedToday ?? 0)"
                              OnClick="@(() => NavigationStat("/identification-types"))" />
                </div>
            </div>

            @if (recentlyCreated is not null)
            {
                <div style="margin-top:22px">
                    <p class="section-title">@CreatedTodayHeadline</p>
                    <p class="section-sub">@L["RecentlyCreatedSubtitle"]</p>

                    @if (recentlyCreated.Count == 0)
                    {
                        <div class="empty">
                            <p>@L["NoRecentlyCreated"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="people">
                            @foreach (var entity in recentlyCreated)
                            {
                                <a class="person" href="@entity.Href" title="@($"{entity.Name} · {L[entity.TypeKey]}")">
                                    <span class="avatar avatar-lg @AvatarClass(entity.AvatarSeed)">@Initials(entity.Name)</span>
                                    <span class="person-name">@entity.Name</span>
                                </a>
                            }
                            <a class="person person-more" href="/users">
                                <span class="avatar avatar-lg">
                                    <Icon Name="arrow-right" Size="18" Stroke="1.8" />
                                </span>
                                <span class="person-name">@L["ViewAll"]</span>
                            </a>
                        </div>
                    }
                </div>
            }
        </section>

        <section class="card">
            <div class="card-head">
                <h2 class="card-title">@L["ValidationsTitle"]</h2>
                <span class="badge badge-gray">@L["Last7Days"]</span>
            </div>

            @if (validationDays is null)
            {
                <div class="spinner spinner-lg spinner-center"></div>
            }
            else
            {
                <div class="chart">
                    <div class="chart-watermark">
                        <b>@totalValidations.ToString("N0")</b>
                        <small>@L["ValidationsSubtitle"]</small>
                    </div>

                    <div class="chart-bars">
                        @foreach (var day in validationDays)
                        {
                            var total = day.SucceededCount + day.FailedCount;
                            var isPeak = total > 0 && total == maxDailyTotal;
                            var height = maxDailyTotal == 0 ? 0 : (double)total / maxDailyTotal * 100;

                            <div class="chart-col" title="@DayTooltip(day)">
                                <div class="chart-track">
                                    @if (isPeak)
                                    {
                                        <span class="bar-tip">@total.ToString("N0")</span>
                                        <span class="bar-dot"></span>
                                    }
                                    <div class="bar @(isPeak ? "bar-peak" : "")" style="height:@Pct(height)"></div>
                                </div>
                                <span class="chart-label">@day.Date.ToString("ddd", CultureInfo.CurrentUICulture)</span>
                            </div>
                        }
                    </div>
                </div>

                <div class="chart-legend">
                    <span class="legend-item"><span class="legend-dot is-peak"></span>@L["ValidationsPeak"]</span>
                    <span class="legend-item"><span class="legend-dot is-base"></span>@L["ValidationsDaily"]</span>
                </div>
            }
        </section>
    </div>

    @* ─────────── right column ─────────── *@
    <div class="dash-col">

        <section class="card">
            <div class="card-head">
                <h2 class="card-title">@L["RecentConnectionsTitle"]</h2>
            </div>

            @if (recentConnections is null)
            {
                <div class="spinner spinner-lg spinner-center"></div>
            }
            else if (recentConnections.Count == 0)
            {
                <div class="empty">
                    <p>@L["NoRecentConnections"]</p>
                </div>
            }
            else
            {
                <div class="list">
                    @foreach (var connection in recentConnections)
                    {
                        <div class="list-row">
                            <span class="avatar @connection.AvatarClass">@Initials(connection.DisplayName)</span>
                            <span class="list-body">
                                <span class="list-title">@connection.DisplayName</span>
                                <span class="list-sub">@connection.Detail</span>
                            </span>
                            <span class="list-meta">
                                <span class="list-amount">@Ago(connection.LastSeen)</span>
                                <span class="badge @(connection.IsActive ? "badge-green" : "badge-red")">
                                    @(connection.IsActive ? L["ActiveStatus"] : L["ExpiredStatus"])
                                </span>
                            </span>
                        </div>
                    }
                </div>

                <div class="list-foot">
                    <a class="btn btn-outline btn-block" href="/sessions">@L["ViewAllSessions"]</a>
                </div>
            }
        </section>

        <section class="card">
            <div class="card-head">
                <h2 class="card-title">@L["RecentActivityTitle"]</h2>
            </div>

            @if (recentActivity is null)
            {
                <div class="spinner spinner-lg spinner-center"></div>
            }
            else if (recentActivity.Count == 0)
            {
                <div class="empty">
                    <p>@L["NoRecentActivity"]</p>
                </div>
            }
            else
            {
                <div class="feed">
                    @foreach (var entry in recentActivity)
                    {
                        <div class="feed-item">
                            <span class="avatar avatar-sm @(entry.Succeeded ? "avatar-c3" : "avatar-c5")">
                                <Icon Name="@(entry.Succeeded ? "check" : "x")" Size="14" Stroke="2.4" />
                            </span>
                            <div class="feed-body">
                                <p class="feed-head">
                                    @UserLabel(entry.UserId)
                                    <span class="muted">@L["ActivityOn"]</span>
                                    @(entry.ClientId ?? L["UnknownClient"])
                                </p>
                                <p class="feed-time">@entry.OccurredAtUtc.ToLocalTime().ToString("t",
                                                                 CultureInfo.CurrentUICulture)</p>
                                    <p class="feed-text">@ActivityText(entry)</p>
                                </div>
                            </div>
                        }
                    </div>
                }
                </section>
            </div>
        </div>

@code {
    private bool isMasterAdmin;
    private int? tenantCount;
    private int? userCount;
    private int? connectedUserCount;
    private int? roleCount;
    private int? scopeCount;
    private int? applicationCount;
    private int? identificationTypeCount;

    private DashboardStatsModel? stats;
    private List<RecentEntityModel>? recentlyCreated;

    private List<DailyValidationCountModel>? validationDays;
    private int totalValidations;
    private int maxDailyTotal;

    private List<RecentConnection>? recentConnections;
    private List<ValidationLogEntryModel>? recentActivity;

    private Dictionary<Guid, string> userNames = [];

    private sealed record RecentConnection(
        string DisplayName, string Detail, bool IsActive, DateTime LastSeen, string AvatarClass);

    private string DeltaText(int count) =>
        count > 0 ? L["CreatedTodayShort", count] : string.Empty;

    private string CreatedTodayHeadline =>
        recentlyCreated is { Count: > 0 } && recentlyCreated.Any(e => e.CreatedAtUtc.Date == DateTime.UtcNow.Date)
            ? L["CreatedTodayHeadline", recentlyCreated.Count(e => e.CreatedAtUtc.Date == DateTime.UtcNow.Date)]
            : L["LatestCreatedHeadline"];

    protected override async Task OnInitializedAsync()
    {
        // The page is gated to the ManagerOrAdmin roles, but only the master admin
        // (Admin in the seed tenant) can call the OIDC endpoints (/api/tenants,
        // /api/roles, /api/applications, /api/scopes): they are protected by the
        // MasterAdminOnly policy. Detect that here so we don't even try — and so the
        // dashboard doesn't surface OIDC/tenant widgets to anyone else.
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        // The WASM client's serialized AuthenticationState only carries the identity's Name
        // and Role claims (AddAuthenticationStateDeserialization drops custom claims like
        // is_master_admin), so the master admin must be detected via the "Admin" role claim,
        // which AdminPasswordSignInService issues only to the master admin.
        isMasterAdmin = authState.User.IsInRole("Admin") || authState.User.IsInRole("Administrator");
        TenantContext.SetMasterAdmin(isMasterAdmin);

        // Each call is guarded so a transient failure or a 403 never crashes the page:
        // the affected card simply keeps showing its loading placeholder.
        try
        {
            stats = await DashboardService.GetStatsAsync();
            connectedUserCount = stats?.ConnectedUsers ?? 0;
            recentlyCreated = stats?.RecentlyCreated;
        }
        catch
        {
            // unreachable for the dashboard: the stats endpoint only requires authentication
        }

        try
        {
            var users = await UserService.GetUsersAsync();
            var userList = users?.Data?.ToList() ?? [];
            userCount = userList.Count;
            userNames = userList.ToDictionary(u => u.Id, u => FullName(u));
        }
        catch
        {
            // not authorized or transient error - the Users card stays on its placeholder
        }

        try
        {
            var sessions = (await UserSessionService.GetActiveSessionsAsync())?.ToList() ?? [];
            BuildRecentConnections(sessions);
        }
        catch
        {
            // not authorized or transient error - the connections list stays on its placeholder
        }

        if (isMasterAdmin)
        {
            try
            {
                var tenants = await TenantService.GetTenantsAsync();
                tenantCount = tenants?.Data?.Count() ?? 0;
            }
            catch
            {
                // Admin-only endpoint refused - the Tenants card stays on its placeholder
            }

            try
            {
                var roles = await RoleService.GetRolesAsync(new PagedRequest { PageSize = 1 });
                roleCount = roles?.Data?.TotalCount ?? 0;
            }
            catch
            {
                // Admin-only endpoint refused - the Roles card stays on its placeholder
            }

            try
            {
                var apps = await ApplicationService.GetApplicationsAsync(new PagedRequest { PageSize = 1 });
                applicationCount = apps?.TotalCount ?? 0;
            }
            catch
            {
                // Admin-only endpoint refused - the Applications card stays on its placeholder
            }

            try
            {
                scopeCount = (await ScopeService.GetScopesAsync())?.Count() ?? 0;
            }
            catch
            {
                // Admin-only endpoint refused - the Scopes card stays on its placeholder
            }
        }

        try
        {
            identificationTypeCount = (await IdentificationTypeService.GetIdentificationTypesAsync())?.Data?.Count() ?? 0;
        }
        catch
        {
            // not authorized or transient error - the Identification types card stays on its placeholder
        }

        try
        {
            var summary = await ValidationLogService.GetDailySummaryAsync(7);
            validationDays = [.. summary];
            totalValidations = validationDays.Sum(d => d.SucceededCount + d.FailedCount);
            maxDailyTotal = validationDays.Count == 0
                ? 0
                : validationDays.Max(d => d.SucceededCount + d.FailedCount);
        }
        catch
        {
            // not authorized or transient error - the chart stays on its placeholder
        }

        try
        {
            recentActivity = [.. await ValidationLogService.GetRecentAsync(5)];
        }
        catch
        {
            // not authorized or transient error - the activity feed stays on its placeholder
        }
    }

    private void BuildRecentConnections(List<UserSessionModel> sessions)
    {
        recentConnections = [.. sessions
            .Where(s => s.UserId is not null && userNames.ContainsKey(s.UserId!.Value))
            .GroupBy(s => s.UserId!.Value)
            .Select(g => g.OrderByDescending(s => s.LastActivityAt ?? s.CreatedAt).First())
            .OrderByDescending(s => s.LastActivityAt ?? s.CreatedAt)
            .Take(5)
            .Select(s =>
            {
                var name = userNames[s.UserId!.Value];
                var detail = string.Join(" · ", new[] { s.Device, s.IpAddress }.Where(x => !string.IsNullOrWhiteSpace(x)));

                return new RecentConnection(
                    name,
                    string.IsNullOrEmpty(detail) ? "-" : detail,
                    s.ExpiresAt > DateTime.UtcNow,
                    s.LastActivityAt ?? s.CreatedAt,
                    AvatarClass(name));
            })];
    }

    private string UserLabel(Guid? userId) =>
        userId is not null && userNames.TryGetValue(userId.Value, out var name) ? name : L["UnknownUser"];

    private string ActivityText(ValidationLogEntryModel entry)
    {
        var what = entry.EventType switch
        {
            "AuthorizeSucceeded" => L["EventAuthorizeSucceeded"].Value,
            "AuthorizeDenied" => L["EventAuthorizeDenied"].Value,
            "TokenIssued" => L["EventTokenIssued"].Value,
            "TokenDenied" => L["EventTokenDenied"].Value,
            "LogoutSucceeded" => L["EventLogoutSucceeded"].Value,
            _ => entry.EventType
        };

        var detail = entry.Succeeded ? entry.Scopes : entry.FailureReason;

        return string.IsNullOrWhiteSpace(detail) ? what : $"{what} · {detail}";
    }

    private string DayTooltip(DailyValidationCountModel day) =>
        $"{day.Date:d} — {L["ValidationsOk"]}: {day.SucceededCount}, {L["ValidationsFailed"]}: {day.FailedCount}";

    private string Ago(DateTime when)
    {
        var span = DateTime.UtcNow - when;

        if (span.TotalMinutes < 1) return L["JustNow"];
        if (span.TotalMinutes < 60) return L["MinutesAgo", (int)span.TotalMinutes];
        if (span.TotalHours < 24) return L["HoursAgo", (int)span.TotalHours];

        return L["DaysAgo", (int)span.TotalDays];
    }

    private static string FullName(UserModel user)
    {
        var name = $"{user.Name} {user.LastName}".Trim();
        return string.IsNullOrWhiteSpace(name) ? user.UserName ?? "-" : name;
    }

    private static string Pct(double value) =>
        value.ToString("0.##", CultureInfo.InvariantCulture) + "%";

    private static string Initials(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";

        var parts = name.Split(' ', StringSplitOptions.RemoveEmptyEntries);

        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant(),
            _ => string.Concat(parts[0][..1], parts[^1][..1]).ToUpperInvariant()
        };
    }

    /// <summary>Stable per-name colour so the same person keeps the same avatar.</summary>
    private static string AvatarClass(string seed)
    {
        var hash = seed.Aggregate(17, (acc, c) => acc * 31 + c);
        return $"avatar-c{Math.Abs(hash) % 5 + 1}";
    }

    private void NavigationStat(string pathNavigation)
    {
        Nav.NavigateTo(pathNavigation);
    }
}
