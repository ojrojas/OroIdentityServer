@page "/users/create"
@attribute [Authorize]
@inject IAdminUserService UserService
@inject IAdminIdentificationTypeService IdentificationTypeService
@inject IAdminTenantService TenantService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NewUserTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["NewUserTitle"]</h2>
    </div>

    @if (identificationTypes is null || tenants is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else
    {
        <div class="form">
            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="name">@L["Name"] <span class="req">*</span></label>
                    <input id="name" class="input" @bind="name" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="middleName">@L["MiddleName"]</label>
                    <input id="middleName" class="input" @bind="middleName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="lastName">@L["LastName"] <span class="req">*</span></label>
                    <input id="lastName" class="input" @bind="lastName" @bind:event="oninput" />
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="userName">@L["Username"] <span class="req">*</span></label>
                    <input id="userName" class="input" @bind="userName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="email">@L["Email"] <span class="req">*</span></label>
                    <input id="email" type="email" class="input" @bind="email" @bind:event="oninput" />
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="password">@L["Password"] <span class="req">*</span></label>
                <input id="password" type="password" class="input" @bind="password" @bind:event="oninput" />
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="identification">@L["Identification"] <span class="req">*</span></label>
                    <input id="identification" class="input" @bind="identification" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="identificationType">@L["IdentificationType"]</label>
                    <select id="identificationType" class="select" @bind="SelectedIdentificationTypeId">
                        @foreach (var type in identificationTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="tenant">@L["Tenant"]</label>
                <select id="tenant" class="select" @bind="SelectedTenantId">
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@(!CanSubmit || saving)" @onclick="SubmitAsync">@L["Create"]</button>
                <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/users")'>@L["Cancel"]</button>
            </div>
        </div>
    }
</section>

@code {
    private List<IdentificationTypeModel>? identificationTypes;
    private List<TenantModel>? tenants;
    private IdentificationTypeModel? selectedIdentificationType;
    private TenantModel? selectedTenant;

    private string name = string.Empty;
    private string middleName = string.Empty;
    private string lastName = string.Empty;
    private string userName = string.Empty;
    private string email = string.Empty;
    private string password = string.Empty;
    private string identification = string.Empty;
    private bool saving;

    private string SelectedIdentificationTypeId
    {
        get => selectedIdentificationType?.Id.ToString() ?? string.Empty;
        set => selectedIdentificationType = identificationTypes?.FirstOrDefault(t => t.Id.ToString() == value);
    }

    private string SelectedTenantId
    {
        get => selectedTenant?.Id.ToString() ?? string.Empty;
        set => selectedTenant = tenants?.FirstOrDefault(t => t.Id.ToString() == value);
    }

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(name) && !string.IsNullOrWhiteSpace(lastName) &&
        !string.IsNullOrWhiteSpace(userName) && !string.IsNullOrWhiteSpace(email) &&
        !string.IsNullOrWhiteSpace(password) && !string.IsNullOrWhiteSpace(identification) &&
        selectedIdentificationType is not null && selectedTenant is not null;

    protected override async Task OnInitializedAsync()
    {
        var identificationTypesResponse = await IdentificationTypeService.GetIdentificationTypesAsync();
        identificationTypes = identificationTypesResponse?.Data?.ToList() ?? [];
        selectedIdentificationType = identificationTypes.FirstOrDefault();

        var tenantsResponse = await TenantService.GetTenantsAsync();
        tenants = tenantsResponse?.Data?.ToList() ?? [];
        selectedTenant = tenants.FirstOrDefault();
    }

    private async Task SubmitAsync()
    {
        saving = true;
        var request = new CreateUserRequest(
            name, middleName, lastName, userName, email, password, identification,
            selectedIdentificationType!.Id, selectedTenant!.Id);

        var response = await UserService.CreateUserAsync(request);
        saving = false;

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["UserCreatedToast"]);
            Nav.NavigateTo("/users");
        }
        else
        {
            ToastService.ShowError(L["UserCreateFailedToast", (int)response.StatusCode]);
        }
    }
}
