@page "/sessions"
@attribute [Authorize(Roles = "Admin,Administrator,Manager")]
@inject IAdminUserService UserService
@inject IAdminUserSessionService UserSessionService
@inject IAdminSessionService SessionService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["SessionsTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["NavUsers"]</h2>
    </div>

    <div class="card-search">
        <input class="input" placeholder="@L["Search"]" @bind="userSearchTerm" @bind:event="oninput" @onkeydown="UserSearchKeyDown" />
    </div>

    @if (users is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else if (users.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">@L["NoData"]</p>
            <p>@L["NoDataHint"]</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["ColUsername"]</th>
                        <th>@L["ColEmail"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="cell-strong">@user.UserName</td>
                            <td class="cell-muted">@user.Email</td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn-row" title="@L["LoadSessions"]" @onclick="@(() => SelectUserAsync(user))">
                                        <Icon Name="arrow-right" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pagination PageNumber="@userPageNumber" TotalPages="@userTotalPages" TotalCount="@userTotalCount"
                    PageSize="@userPageSize" PageNumberChanged="OnUserPageNumberChanged" PageSizeChanged="OnUserPageSizeChanged" />
    }
</section>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">
            @(selectedUser is null ? L["SelectUserPrompt"] : L["SessionsForUser", selectedUser.UserName ?? string.Empty])
        </h2>
    </div>

    @if (selectedUser is not null)
    {
        <div class="card-filters">
            <div class="field">
                <label class="field-label" for="dateFrom">@L["DateFrom"]</label>
                <input id="dateFrom" type="date" class="input" @bind="dateFrom" />
            </div>
            <div class="field">
                <label class="field-label" for="dateTo">@L["DateTo"]</label>
                <input id="dateTo" type="date" class="input" @bind="dateTo" />
            </div>
            <button type="button" class="btn btn-outline btn-sm" @onclick="LoadSessionsAsync">@L["Filter"]</button>
        </div>

        @if (sessions is null)
        {
            <div class="spinner spinner-lg spinner-center"></div>
        }
        else if (sessions.Count == 0)
        {
            <div class="empty">
                <p class="empty-title">@L["NoActiveSessions"]</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["ColDevice"]</th>
                            <th>@L["ColIp"]</th>
                            <th>@L["ColLastActivity"]</th>
                            <th>@L["ColExpires"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var session in sessions)
                        {
                            <tr>
                                <td class="cell-strong">@session.Device</td>
                                <td class="cell-muted">@session.IpAddress</td>
                                <td>@session.LastActivityAt</td>
                                <td>@session.ExpiresAt</td>
                                <td>
                                    <div class="actions">
                                        <button type="button" class="btn-row is-danger" title="@L["Disconnect"]" @onclick="@(() => DisconnectAsync(session))">
                                            <Icon Name="disconnect" Size="15" />
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    }
</section>

@if (selectedUser is not null)
{
    <section class="card">
        <div class="card-head">
            <h2 class="card-title">@L["SessionHistory"]</h2>
        </div>

        <div class="card-filters">
            <div class="field">
                <label class="field-label" for="historyDateFrom">@L["DateFrom"]</label>
                <input id="historyDateFrom" type="date" class="input" @bind="historyDateFrom" />
            </div>
            <div class="field">
                <label class="field-label" for="historyDateTo">@L["DateTo"]</label>
                <input id="historyDateTo" type="date" class="input" @bind="historyDateTo" />
            </div>
            <button type="button" class="btn btn-outline btn-sm" @onclick="LoadHistoryAsync">@L["Filter"]</button>
        </div>

        @if (sessionHistory is null)
        {
            <div class="spinner spinner-lg spinner-center"></div>
        }
        else if (sessionHistory.Count == 0)
        {
            <div class="empty">
                <p class="empty-title">@L["NoSessionHistory"]</p>
            </div>
        }
        else
        {
            <div class="table-wrap">
                <table class="table">
                    <thead>
                        <tr>
                            <th>@L["ColIp"]</th>
                            <th>@L["ColCountry"]</th>
                            <th>@L["ColStartedAt"]</th>
                            <th>@L["ColEndedAt"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in sessionHistory)
                        {
                            <tr>
                                <td class="cell-strong">@entry.IpAddress</td>
                                <td class="cell-muted">@entry.Country</td>
                                <td>@entry.StartedAtUtc.ToString("g")</td>
                                <td>
                                    @if (entry.EndedAtUtc is null)
                                    {
                                        <span class="badge badge-green">@L["ActiveStatus"]</span>
                                    }
                                    else
                                    {
                                        @entry.EndedAtUtc.Value.ToString("g")
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <Pagination PageNumber="@historyPageNumber" TotalPages="@historyTotalPages" TotalCount="@historyTotalCount"
                        PageSize="@historyPageSize" PageNumberChanged="OnHistoryPageNumberChanged" PageSizeChanged="OnHistoryPageSizeChanged" />
        }
    </section>
}

@code {
    private List<UserModel>? users;
    private UserModel? selectedUser;
    private List<UserSessionModel>? sessions;
    private List<SessionModel>? sessionHistory;

    private string userSearchTerm = string.Empty;
    private int userPageNumber = 1;
    private int userPageSize = 20;
    private int userTotalCount;
    private int userTotalPages;

    private DateTime? dateFrom;
    private DateTime? dateTo;

    private DateTime? historyDateFrom;
    private DateTime? historyDateTo;
    private int historyPageNumber = 1;
    private int historyPageSize = 20;
    private int historyTotalCount;
    private int historyTotalPages;

    protected override async Task OnInitializedAsync() => await LoadUsersAsync();

    private async Task LoadUsersAsync()
    {
        var response = await UserService.GetUsersPagedAsync(new PagedRequest
        {
            SearchTerm = userSearchTerm,
            PageNumber = userPageNumber,
            PageSize = userPageSize
        });
        users = response?.Data?.Items?.ToList() ?? [];
        userTotalCount = response?.Data?.TotalCount ?? 0;
        userTotalPages = (int)Math.Ceiling((double)userTotalCount / userPageSize);
    }

    private async Task UserSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            userPageNumber = 1;
            await LoadUsersAsync();
        }
    }

    private async Task OnUserPageNumberChanged(int page)
    {
        userPageNumber = page;
        await LoadUsersAsync();
    }

    private async Task OnUserPageSizeChanged(int size)
    {
        userPageSize = size;
        userPageNumber = 1;
        await LoadUsersAsync();
    }

    private async Task SelectUserAsync(UserModel user)
    {
        selectedUser = user;
        sessions = null;
        sessionHistory = null;
        historyPageNumber = 1;
        await LoadSessionsAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadSessionsAsync()
    {
        if (selectedUser is null) return;

        sessions = null;
        var result = await UserSessionService.GetByUserAsync(selectedUser.Id);
        var allSessions = result?.ToList() ?? [];

        if (dateFrom.HasValue)
            allSessions = allSessions.Where(s => s.CreatedAt >= dateFrom.Value).ToList();
        if (dateTo.HasValue)
            allSessions = allSessions.Where(s => s.CreatedAt <= dateTo.Value.AddDays(1)).ToList();

        sessions = allSessions;
    }

    private async Task LoadHistoryAsync()
    {
        if (selectedUser is null) return;

        sessionHistory = null;
        var historyResponse = await SessionService.GetByUserAsync(selectedUser.Id);
        var allHistory = historyResponse?.Data?.ToList() ?? [];

        if (historyDateFrom.HasValue)
            allHistory = allHistory.Where(s => s.StartedAtUtc >= historyDateFrom.Value).ToList();
        if (historyDateTo.HasValue)
            allHistory = allHistory.Where(s => s.StartedAtUtc <= historyDateTo.Value.AddDays(1)).ToList();

        historyTotalCount = allHistory.Count;
        var skip = (historyPageNumber - 1) * historyPageSize;
        sessionHistory = allHistory.Skip(skip).Take(historyPageSize).ToList();
        historyTotalPages = (int)Math.Ceiling((double)historyTotalCount / historyPageSize);
    }

    private async Task OnHistoryPageNumberChanged(int page)
    {
        historyPageNumber = page;
        await LoadHistoryAsync();
    }

    private async Task OnHistoryPageSizeChanged(int size)
    {
        historyPageSize = size;
        historyPageNumber = 1;
        await LoadHistoryAsync();
    }

    private async Task DisconnectAsync(UserSessionModel session)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DisconnectConfirm"],
            L["Disconnect"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await UserSessionService.DeactivateUserSessionAsync(session.Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["SessionDisconnectedToast"]);
            if (selectedUser is not null)
                await LoadSessionsAsync();
        }
        else
        {
            ToastService.ShowError(L["SessionDisconnectFailedToast", (int)response.StatusCode]);
        }
    }
}
