@page "/scopes/create"
@attribute [Authorize(Roles = "Admin")]
@inject IAdminScopeService ScopeService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NewScopeTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["NewScopeTitle"]</h2>
    </div>

    <div class="form">
        <div class="field">
            <label class="field-label" for="scopeName">@L["ScopeName"] <span class="req">*</span></label>
            <input id="scopeName" class="input" @bind="name" @bind:event="oninput" />
        </div>

        <div class="field">
            <label class="field-label" for="resources">@L["Resources"]</label>
            <input id="resources" class="input" @bind="resources" @bind:event="oninput" />
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(name) || saving)" @onclick="SubmitAsync">@L["Create"]</button>
            <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/scopes")'>@L["Cancel"]</button>
        </div>
    </div>
</section>

@code {
    private string name = string.Empty;
    private string resources = string.Empty;
    private bool saving;

    private async Task SubmitAsync()
    {
        saving = true;
        var resourceList = resources.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var response = await ScopeService.CreateScopeAsync(new CreateOpenIddictScopeRequest(name, resourceList));
        saving = false;

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["ScopeCreatedToast"]);
            Nav.NavigateTo("/scopes");
        }
        else
        {
            ToastService.ShowError(L["ScopeCreateFailedToast", (int)response.StatusCode]);
        }
    }
}
