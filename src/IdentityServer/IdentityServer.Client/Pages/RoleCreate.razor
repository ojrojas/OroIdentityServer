@page "/roles/create"
@attribute [Authorize]
@inject IAdminRoleService RoleService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NewRoleTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["NewRoleTitle"]</h2>
    </div>

    <div class="form">
        <div class="field">
            <label class="field-label" for="roleName">@L["RoleName"] <span class="req">*</span></label>
            <input id="roleName" class="input" @bind="roleName" @bind:event="oninput" />
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(roleName) || saving)" @onclick="SubmitAsync">@L["Create"]</button>
            <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/roles")'>@L["Cancel"]</button>
        </div>
    </div>
</section>

@code {
    private string roleName = string.Empty;
    private bool saving;

    private async Task SubmitAsync()
    {
        saving = true;
        var response = await RoleService.CreateRoleAsync(new CreateRoleRequest(roleName));
        saving = false;

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["RoleCreatedToast"]);
            Nav.NavigateTo("/roles");
        }
        else
        {
            ToastService.ShowError(L["RoleCreateFailedToast", (int)response.StatusCode]);
        }
    }
}
