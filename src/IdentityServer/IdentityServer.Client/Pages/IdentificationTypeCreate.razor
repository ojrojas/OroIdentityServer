@page "/identification-types/create"
@attribute [Authorize(Roles = "Admin,Manager")]
@inject IAdminIdentificationTypeService IdentificationTypeService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NewIdentificationTypeTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["NewIdentificationTypeTitle"]</h2>
    </div>

    <div class="form">
        <div class="field">
            <label class="field-label" for="name">@L["Name"] <span class="req">*</span></label>
            <input id="name" class="input" @bind="name" @bind:event="oninput" />
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(name) || saving)" @onclick="SubmitAsync">@L["Create"]</button>
            <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/identification-types")'>@L["Cancel"]</button>
        </div>
    </div>
</section>

@code {
    private string name = string.Empty;
    private bool saving;

    private async Task SubmitAsync()
    {
        saving = true;
        var response = await IdentificationTypeService.CreateIdentificationTypeAsync(new CreateIdentificationTypeRequest(name));
        saving = false;

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["IdentificationTypeCreatedToast"]);
            Nav.NavigateTo("/identification-types");
        }
        else
        {
            ToastService.ShowError(L["IdentificationTypeCreateFailedToast", (int)response.StatusCode]);
        }
    }
}
