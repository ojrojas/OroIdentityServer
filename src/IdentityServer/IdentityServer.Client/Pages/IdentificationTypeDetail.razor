@page "/identification-types/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Administrator,Manager")]
@inject IAdminIdentificationTypeService IdentificationTypeService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["IdentificationTypeDetailTitle"]</PageTitle>

<Breadcrumb Items="@([new BreadcrumbItem(L["NavIdentificationTypes"], "/identification-types"), new BreadcrumbItem(string.IsNullOrWhiteSpace(name) ? L["IdentificationTypeDetailTitle"] : name)])" />

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["IdentificationTypeDetailTitle"]</h2>
    </div>

    @if (item is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else
    {
        <div class="form">
            <div class="field">
                <label class="field-label" for="name">@L["Name"] <span class="req">*</span></label>
                <input id="name" class="input" @bind="name" @bind:event="oninput" />
            </div>

            <label class="switch-row" for="isActive">
                <span class="switch-row-text">
                    <span class="switch-row-label">@L["Active"]</span>
                    <span class="switch-row-sub">@L["IsActiveHint"]</span>
                </span>
                <input id="isActive" type="checkbox" class="switch" @bind="isActive" />
            </label>

            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">@L["Save"]</button>
                <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/identification-types")'>@L["Back"]</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">
                    <Icon Name="trash" Size="15" /> @L["Delete"]
                </button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private IdentificationTypeModel? item;
    private string name = string.Empty;
    private bool isActive;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        var response = await IdentificationTypeService.GetIdentificationTypeByIdAsync(Id);
        item = response?.Data;
        if (item is not null)
        {
            name = item.Name;
            isActive = item.IsActive;
        }
    }

    private async Task SaveAsync()
    {
        saving = true;
        var response = await IdentificationTypeService.UpdateIdentificationTypeAsync(Id, new UpdateIdentificationTypeRequest(name));
        saving = false;

        if (response.IsSuccessStatusCode)
            ToastService.ShowSuccess(L["SavedToast"]);
        else
            ToastService.ShowError(L["SaveFailedToast", (int)response.StatusCode]);
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteIdentificationTypeConfirm", name],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await IdentificationTypeService.DeleteIdentificationTypeAsync(Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["IdentificationTypeDeletedToast"]);
            Nav.NavigateTo("/identification-types");
        }
        else
        {
            ToastService.ShowError(L["IdentificationTypeDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
