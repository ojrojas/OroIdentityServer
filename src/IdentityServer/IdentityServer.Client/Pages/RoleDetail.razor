@page "/roles/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Administrator,Manager")]
@inject IAdminRoleService RoleService
@inject IAdminPermissionService PermissionService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["RoleDetailTitle"]</PageTitle>

<Breadcrumb Items="@([new BreadcrumbItem(L["NavRoles"], "/roles"), new BreadcrumbItem(string.IsNullOrWhiteSpace(roleName) ? L["RoleDetailTitle"] : roleName)])" />

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["RoleDetailTitle"]</h2>
    </div>

    @if (item is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else
    {
        <div class="form">
            <div class="field">
                <label class="field-label" for="roleName">@L["RoleName"] <span class="req">*</span></label>
                <input id="roleName" class="input" @bind="roleName" @bind:event="oninput" />
            </div>

            <div class="field">
                <label class="field-label" for="roleLevel">@L["HierarchyLevel"]</label>
                <input id="roleLevel" class="input" type="number" min="10" max="100" step="10" @bind="roleLevel" />
            </div>

            <div class="field">
                <label class="field-label" for="parentRole">@L["ParentRole"]</label>
                <select id="parentRole" class="select" @bind="parentRoleId">
                    <option value="">@L["None"]</option>
                    @if (allRoles != null)
                    {
                        @foreach (var r in allRoles.Where(x => x.Id != Id))
                        {
                            <option value="@r.Id">@r.Name (@r.Level)</option>
                        }
                    }
                </select>
            </div>

            <label class="switch-row" for="isActive">
                <span class="switch-row-text">
                    <span class="switch-row-label">@L["Active"]</span>
                    <span class="switch-row-sub">@L["IsActiveHint"]</span>
                </span>
                <input id="isActive" type="checkbox" class="switch" @bind="isActive" />
            </label>

            <div class="field">
                <label class="field-label">@L["RolePermissionsLabel"]</label>
                <span class="field-hint">@L["RolePermissionsHint"]</span>
                @if (allPermissions is null)
                {
                    <div class="spinner spinner-sm"></div>
                }
                else
                {
                    <div class="checklist">
                        @foreach (var p in allPermissions)
                        {
                            <label class="checklist-item">
                                <input type="checkbox" checked="@selectedPermissions.Contains(p.PermissionId)" @onchange="args => TogglePermission(p.PermissionId, (bool)args.Value!)" />
                                <span class="checklist-label">@p.Description</span>
                                <code class="checklist-code">@PermissionName(p)</code>
                            </label>
                        }
                    </div>
                }
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">@L["Save"]</button>
                <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/roles")'>@L["Back"]</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">
                    <Icon Name="trash" Size="15" /> @L["Delete"]
                </button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private RoleModel? item;
    private string roleName = string.Empty;
    private int roleLevel = 10;
    private string? parentRoleId;
    private List<RoleModel>? allRoles;
    private bool isActive = false;
    private bool saving;
    private List<PermissionModel>? allPermissions;
    private readonly HashSet<Guid> selectedPermissions = [];

    protected override async Task OnInitializedAsync()
    {
        var response = await RoleService.GetRoleByIdAsync(Id);
        item = response?.Data;
        if (item is not null)
        {
            roleName = item.Name ?? string.Empty;
            roleLevel = item.Level;
            parentRoleId = item.ParentRoleId?.ToString();

            selectedPermissions.Clear();
            foreach (var claim in item.Claims ?? [])
                selectedPermissions.Add(claim.PermissionId);
        }

        var all = await RoleService.GetRolesAsync(new PagedRequest { PageSize = 1000 });
        allRoles = all?.Data?.Items?.ToList();

        var permissions = await PermissionService.GetPermissionsAsync();
        allPermissions = permissions?.Data?.ToList();
    }

    private void TogglePermission(Guid permissionId, bool isChecked)
    {
        if (isChecked) selectedPermissions.Add(permissionId);
        else selectedPermissions.Remove(permissionId);
    }

    private static string PermissionName(PermissionModel permission)
        => $"{permission.Provider}.{permission.Resource}.{permission.Action}".ToLowerInvariant();

    private async Task SaveAsync()
    {
        saving = true;
        Guid? parentGuid = string.IsNullOrWhiteSpace(parentRoleId) ? null : Guid.Parse(parentRoleId);
        var response = await RoleService.UpdateRoleAsync(Id, new UpdateRoleRequest(roleName, roleLevel, parentGuid));

        if (response.IsSuccessStatusCode)
        {
            if (item is not null && isActive && !item.IsActive)
            {
                await RoleService.ActivateRoleAsync(Id);
            }

            var permissionsResponse = await RoleService.SetRolePermissionsAsync(
                Id, new SetRolePermissionsRequest([.. selectedPermissions]));
            if (!permissionsResponse.IsSuccessStatusCode)
            {
                saving = false;
                ToastService.ShowError(L["SaveFailedToast", (int)permissionsResponse.StatusCode]);
                return;
            }
        }

        saving = false;

        if (response.IsSuccessStatusCode)
            ToastService.ShowSuccess(L["SavedToast"]);
        else
            ToastService.ShowError(L["SaveFailedToast", (int)response.StatusCode]);
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteRoleConfirm", roleName],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await RoleService.DeleteRoleAsync(Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["RoleDeletedToast"]);
            Nav.NavigateTo("/roles");
        }
        else if ((int)response.StatusCode == 409)
        {
            ToastService.ShowError(L["RoleDeleteConflictToast"]);
        }
        else
        {
            ToastService.ShowError(L["RoleDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
