@page "/scopes"
@attribute [Authorize(Roles = "Admin")]
@inject IAdminScopeService ScopeService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ScopesTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["ScopesTitle"]</h2>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync">
            <Icon Name="plus" Size="15" Stroke="2.2" /> @L["New"]
        </button>
    </div>

    @if (items is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else if (items.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">@L["NoData"]</p>
            <p>@L["NoDataHint"]</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["Name"]</th>
                        <th>@L["ColDisplayName"]</th>
                        <th>@L["ColResources"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="cell-strong">@item.Name</td>
                            <td>@item.DisplayName</td>
                            <td class="cell-muted">@(item.Resources == null ? "" : string.Join(", ", item.Resources))</td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn-row" title="@L["Edit"]" @onclick="@(() => Nav.NavigateTo($"/scopes/{item.Name}"))">
                                        <Icon Name="edit" Size="15" />
                                    </button>
                                    <button type="button" class="btn-row is-danger" title="@L["Delete"]" @onclick="@(() => DeleteAsync(item))">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

@code {
    private List<OpenIddictScopeModel>? items;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var response = await ScopeService.GetScopesAsync();
        items = response?.ToList() ?? [];
    }

    private void CreateAsync() => Nav.NavigateTo("/scopes/create");

    private async Task DeleteAsync(OpenIddictScopeModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteScopeConfirm", item.Name ?? string.Empty],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await ScopeService.DeleteScopeAsync(item.Name!);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["ScopeDeletedToast"]);
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(L["ScopeDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
