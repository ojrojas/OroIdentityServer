@page "/scopes/{Name}"
@attribute [Authorize(Roles = "Admin,Administrator")]
@inject IAdminScopeService ScopeService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ScopeDetailTitle"]</PageTitle>

<Breadcrumb Items="@([new BreadcrumbItem(L["NavScopes"], "/scopes"), new BreadcrumbItem(string.IsNullOrWhiteSpace(Name) ? L["ScopeDetailTitle"] : Name)])" />

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["ScopeDetailTitle"]</h2>
    </div>

    @if (item is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else
    {
        <div class="form">
            <div class="field">
                <label class="field-label" for="scopeName">@L["ScopeName"]</label>
                <input id="scopeName" class="input" value="@Name" readonly />
            </div>

            <div class="field">
                <label class="field-label" for="resources">@L["Resources"]</label>
                <input id="resources" class="input" @bind="resources" @bind:event="oninput" />
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">@L["Save"]</button>
                <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/scopes")'>@L["Back"]</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">
                    <Icon Name="trash" Size="15" /> @L["Delete"]
                </button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public string Name { get; set; } = string.Empty;

    private OpenIddictScopeModel? item;
    private string resources = string.Empty;
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        var scopes = await ScopeService.GetScopesAsync();
        item = scopes?.FirstOrDefault(s => s.Name == Name);
        if (item is not null)
            resources = string.Join(", ", item.Resources ?? []);
    }

    private async Task SaveAsync()
    {
        saving = true;
        var resourceList = resources.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        var response = await ScopeService.UpdateScopeAsync(Name, new UpdateOpenIddictScopeRequest(Name, resourceList));
        saving = false;

        if (response.IsSuccessStatusCode)
            ToastService.ShowSuccess(L["SavedToast"]);
        else
            ToastService.ShowError(L["SaveFailedToast", (int)response.StatusCode]);
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteScopeConfirm", Name],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await ScopeService.DeleteScopeAsync(Name);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["ScopeDeletedToast"]);
            Nav.NavigateTo("/scopes");
        }
        else
        {
            ToastService.ShowError(L["ScopeDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
