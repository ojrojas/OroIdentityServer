@page "/applications/create"
@attribute [Authorize]
@inject IAdminApplicationService ApplicationService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NewApplicationTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["NewApplicationTitle"]</h2>
    </div>

    <div class="form">
        <div class="form-grid">
            <div class="field">
                <label class="field-label" for="clientId">@L["ClientId"] <span class="req">*</span></label>
                <input id="clientId" class="input" @bind="clientId" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field-label" for="displayName">@L["DisplayName"]</label>
                <input id="displayName" class="input" @bind="displayName" @bind:event="oninput" />
            </div>
        </div>

        <div class="form-grid">
            <div class="field">
                <label class="field-label" for="clientSecret">@L["ClientSecret"]</label>
                <input id="clientSecret" type="password" class="input" placeholder="@L["ClientSecretNewPlaceholder"]" @bind="clientSecret" @bind:event="oninput" />
            </div>
            <div class="field">
                <label class="field-label" for="clientType">@L["ClientType"]</label>
                <select id="clientType" class="select" @bind="clientType">
                    <option value="confidential">confidential</option>
                    <option value="public">public</option>
                </select>
            </div>
        </div>

        <div class="field">
            <label class="field-label">@L["RedirectUris"]</label>
            <TagInput @bind-Values="redirectUris" />
        </div>

        <div class="field">
            <label class="field-label">@L["PostLogoutRedirectUris"]</label>
            <TagInput @bind-Values="postLogoutRedirectUris" />
        </div>

        <div class="form-actions">
            <button type="button" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(clientId) || saving)" @onclick="SubmitAsync">@L["Create"]</button>
            <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/applications")'>@L["Cancel"]</button>
        </div>
    </div>
</section>

@code {
    private string clientId = string.Empty;
    private string displayName = string.Empty;
    private string clientSecret = string.Empty;
    private string clientType = "confidential";
    private List<string> redirectUris = [];
    private List<string> postLogoutRedirectUris = [];
    private bool saving;

    private async Task SubmitAsync()
    {
        saving = true;
        var model = new OpenIddictApplicationModel(
            clientId, string.IsNullOrWhiteSpace(clientSecret) ? null : clientSecret, displayName, clientType,
            "web", "implicit", [], [], redirectUris, postLogoutRedirectUris);

        var response = await ApplicationService.CreateApplicationAsync(model);
        saving = false;

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["ApplicationCreatedToast"]);
            Nav.NavigateTo("/applications");
        }
        else
        {
            ToastService.ShowError(L["ApplicationCreateFailedToast", (int)response.StatusCode]);
        }
    }
}
