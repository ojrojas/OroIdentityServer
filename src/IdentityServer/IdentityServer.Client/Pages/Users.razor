@page "/users"
@attribute [Authorize(Roles = "Admin,Administrator,Manager")]
@inject IAdminUserService UserService
@inject IAdminUserSessionService UserSessionService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["UsersTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["UsersTitle"]</h2>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync">
            <Icon Name="plus" Size="15" Stroke="2.2" /> @L["New"]
        </button>
    </div>
    <div class="card-search">
        <input class="input" placeholder="@L["Search"]" @bind="searchTerm" @bind:event="oninput" @onkeydown="SearchKeyDown" />
    </div>

    @if (items is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else if (items.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">@L["NoData"]</p>
            <p>@L["NoDataHint"]</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["ColUsername"]</th>
                        <th>@L["ColName"]</th>
                        <th>@L["ColEmail"]</th>
                        <th class="num">@L["ColRoles"]</th>
                        <th>@L["ColStatus"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="cell-strong">@item.UserName</td>
                            <td>@($"{item.Name} {item.LastName}")</td>
                            <td class="cell-muted">@item.Email</td>
                            <td class="num">@item.Roles.Count</td>
                            <td>
                                @if (item.IsLocked)
                                {
                                    <span class="badge badge-red">@L["Locked"]</span>
                                }
                                else if (!item.IsActive)
                                {
                                    <span class="badge badge-gray">@L["Inactive"]</span>
                                }
                                else
                                {
                                    <span class="badge badge-green">@L["ActiveStatus"]</span>
                                }
                            </td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn-row" title="@L["Edit"]" @onclick="@(() => Nav.NavigateTo($"/users/{item.Id}"))">
                                        <Icon Name="edit" Size="15" />
                                    </button>
                                    <button type="button" class="btn-row" title="@(item.IsLocked ? L["UnlockUser"] : L["LockUser"])" @onclick="@(() => ToggleLockAsync(item))">
                                        <Icon Name="@(item.IsLocked ? "unlock" : "lock")" Size="15" />
                                    </button>
                                    @if (item.IsActive)
                                    {
                                        <button type="button" class="btn-row" title="@L["DeactivateUser"]" @onclick="@(() => DeactivateAsync(item))">
                                            <Icon Name="x-circle" Size="15" />
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn-row" title="@L["ActivateUser"]" @onclick="@(() => ActivateAsync(item))">
                                            <Icon Name="check-circle" Size="15" />
                                        </button>
                                    }
                                    <button type="button" class="btn-row" title="@L["Disconnect"]" @onclick="@(() => TerminateSessionsAsync(item))">
                                        <Icon Name="disconnect" Size="15" />
                                    </button>
                                    <button type="button" class="btn-row is-danger" title="@L["Delete"]" @onclick="@(() => DeleteAsync(item))">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pagination PageNumber="@pageNumber" TotalPages="@totalPages" TotalCount="@totalCount"
                    PageSize="@pageSize" PageNumberChanged="OnPageNumberChanged" PageSizeChanged="OnPageSizeChanged" />
    }
</section>

@code {
    private List<UserModel>? items;
    private string searchTerm = string.Empty;
    private int pageNumber = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var response = await UserService.GetUsersPagedAsync(new PagedRequest
        {
            SearchTerm = searchTerm,
            PageNumber = pageNumber,
            PageSize = pageSize
        });
        items = response?.Data?.Items?.ToList() ?? [];
        totalCount = response?.Data?.TotalCount ?? 0;
        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    }

    private async Task SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            pageNumber = 1;
            await LoadAsync();
        }
    }

    private async Task OnPageNumberChanged(int page)
    {
        pageNumber = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;
        pageNumber = 1;
        await LoadAsync();
    }

    private void CreateAsync() => Nav.NavigateTo("/users/create");

    private async Task DeleteAsync(UserModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteUserConfirm", item.UserName ?? string.Empty],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await UserService.DeleteUserAsync(item.Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["UserDeletedToast"]);
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(L["UserDeleteFailedToast", (int)response.StatusCode]);
        }
    }

    private async Task ToggleLockAsync(UserModel item)
    {
        if (item.IsLocked)
        {
            var ok = await DialogService.ConfirmAsync(
                L["ConfirmActionTitle"], L["UnlockUserConfirm", item.UserName ?? string.Empty],
                L["UnlockUser"], L["Cancel"]);
            if (!ok) return;

            var response = await UserService.UnlockUserAsync(item.Id);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(L["UserUnlockedToast"]);
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(L["UserUnlockFailedToast", (int)response.StatusCode]);
            }
        }
        else
        {
            var ok = await DialogService.ConfirmAsync(
                L["ConfirmActionTitle"], L["LockUserConfirm", item.UserName ?? string.Empty],
                L["LockUser"], L["Cancel"]);
            if (!ok) return;

            var response = await UserService.LockUserAsync(item.Id);
            if (response.IsSuccessStatusCode)
            {
                ToastService.ShowSuccess(L["UserLockedToast"]);
                await LoadAsync();
            }
            else
            {
                ToastService.ShowError(L["UserLockFailedToast", (int)response.StatusCode]);
            }
        }
    }

    private async Task DeactivateAsync(UserModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmActionTitle"], L["DeactivateUserConfirm", item.UserName ?? string.Empty],
            L["DeactivateUser"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await UserService.DeactivateUserAsync(item.Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["UserDeactivatedToast"]);
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(L["UserDeactivateFailedToast", (int)response.StatusCode]);
        }
    }

    private async Task ActivateAsync(UserModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmActionTitle"], L["ActivateUserConfirm", item.UserName ?? string.Empty],
            L["ActivateUser"], L["Cancel"]);
        if (!ok) return;

        var response = await UserService.ActivateUserAsync(item.Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["UserActivatedToast"]);
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(L["UserActivateFailedToast", (int)response.StatusCode]);
        }
    }

    private async Task TerminateSessionsAsync(UserModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmActionTitle"], L["TerminateSessionsConfirm", item.UserName ?? string.Empty],
            L["Disconnect"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await UserSessionService.TerminateAllUserSessionsAsync(item.Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["AllSessionsTerminatedToast"]);
        }
        else
        {
            ToastService.ShowError(L["SessionsTerminateFailedToast", (int)response.StatusCode]);
        }
    }
}
