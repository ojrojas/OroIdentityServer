@page "/users/{Id:guid}"
@attribute [Authorize(Roles = "Admin,Administrator,Manager")]
@inject IAdminUserService UserService
@inject IAdminIdentificationTypeService IdentificationTypeService
@inject IAdminTenantService TenantService
@inject IAdminRoleService RoleService
@inject ICurrentTenantContext TenantContext
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["UserDetailTitle"]</PageTitle>

<Breadcrumb Items="@([new BreadcrumbItem(L["NavUsers"], "/users"), new BreadcrumbItem(string.IsNullOrWhiteSpace(userName) ? L["UserDetailTitle"] : userName)])" />

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["UserDetailTitle"]</h2>
    </div>

    @if (item is null || identificationTypes is null || tenants is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else
    {
        <div class="form">
            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="name">@L["Name"] <span class="req">*</span></label>
                    <input id="name" class="input" @bind="name" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="middleName">@L["MiddleName"]</label>
                    <input id="middleName" class="input" @bind="middleName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="lastName">@L["LastName"] <span class="req">*</span></label>
                    <input id="lastName" class="input" @bind="lastName" @bind:event="oninput" />
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="userName">@L["Username"] <span class="req">*</span></label>
                    <input id="userName" class="input" @bind="userName" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="email">@L["Email"] <span class="req">*</span></label>
                    <input id="email" type="email" class="input" @bind="email" @bind:event="oninput" />
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="password">@L["Password"]</label>
                <input id="password" type="password" class="input" value="@password" @onfocus="OnPasswordFocus" @oninput="OnPasswordInput" placeholder="@L["NewPasswordRequiredPlaceholder"]" />
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="identification">@L["Identification"] <span class="req">*</span></label>
                    <input id="identification" class="input" @bind="identification" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="identificationType">@L["IdentificationType"]</label>
                    <select id="identificationType" class="select" @bind="SelectedIdentificationTypeId">
                        @foreach (var type in identificationTypes)
                        {
                            <option value="@type.Id">@type.Name</option>
                        }
                    </select>
                </div>
            </div>

            <div class="field">
                <label class="field-label" for="tenant">@L["Tenant"]</label>
                <select id="tenant" class="select" @bind="SelectedTenantId">
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Id">@tenant.Name</option>
                    }
                </select>
            </div>

            <label class="switch-row" for="isActive">
                <span class="switch-row-text">
                    <span class="switch-row-label">@L["Active"]</span>
                    <span class="switch-row-sub">@L["IsActiveHint"]</span>
                </span>
                <input id="isActive" type="checkbox" class="switch" @bind="isActive" />
            </label>

            <div class="field">
                <label class="field-label">@L["RoleAssignmentSection"]</label>
                <span class="field-hint">@L["SelectRolesForUser"]</span>

                <div style="display:flex; gap:8px; margin-top:6px;">
                    <select class="select" style="flex:1" @bind="roleIdToAdd" disabled="@savingRoles">
                        <option value="">@L["SelectRolePlaceholder"]</option>
                        @foreach (var role in AvailableRoles)
                        {
                            <option value="@role.Id">@role.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline" style="flex-shrink:0"
                            disabled="@(string.IsNullOrEmpty(roleIdToAdd) || savingRoles)" @onclick="AddRoleAsync">
                        <Icon Name="plus" Size="15" Stroke="2.2" /> @L["AddRoleButton"]
                    </button>
                </div>
            </div>

            <div class="field">
                @if (assignedRoles.Count == 0)
                {
                    <p class="field-hint">@L["NoRolesAssigned"]</p>
                }
                else
                {
                    <div class="tags">
                        @foreach (var role in assignedRoles)
                        {
                            <span class="tag">
                                <span>@role.Name</span>
                                <button type="button" class="tag-x" title="@L["RemoveRoleTitle"]" disabled="@savingRoles"
                                        @onclick="() => RemoveRoleAsync(role.Id)">
                                    <Icon Name="x" Size="11" Stroke="2.4" />
                                </button>
                            </span>
                        }
                    </div>
                }
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">@L["Save"]</button>
                <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/users")'>@L["Back"]</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">
                    <Icon Name="trash" Size="15" /> @L["Delete"]
                </button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public Guid Id { get; set; }

    private UserModel? item;
    private List<IdentificationTypeModel>? identificationTypes;
    private List<RoleModel>? roles = [];
    private List<RoleModel> assignedRoles = [];
    private List<TenantModel>? tenants;
    private IdentificationTypeModel? selectedIdentificationType;
    private TenantModel? selectedTenant;

    private string roleIdToAdd = string.Empty;
    private bool savingRoles;

    private string name = string.Empty;
    private string middleName = string.Empty;
    private string lastName = string.Empty;
    private string userName = string.Empty;
    private string email = string.Empty;
    private string password = "**********";
    private string identification = string.Empty;
    private bool isActive = true;
    private bool saving;

    private void OnPasswordFocus(FocusEventArgs _) { if (password == "**********") password = string.Empty; }
    private void OnPasswordInput(ChangeEventArgs e) => password = e.Value?.ToString() ?? string.Empty;

    private IEnumerable<RoleModel> AvailableRoles =>
        (roles ?? []).Where(r => assignedRoles.All(a => a.Id != r.Id));

    private string SelectedIdentificationTypeId
    {
        get => selectedIdentificationType?.Id.ToString() ?? string.Empty;
        set => selectedIdentificationType = identificationTypes?.FirstOrDefault(t => t.Id.ToString() == value);
    }

    private string SelectedTenantId
    {
        get => selectedTenant?.Id.ToString() ?? string.Empty;
        set => selectedTenant = tenants?.FirstOrDefault(t => t.Id.ToString() == value);
    }

    protected override async Task OnInitializedAsync()
    {
        var identificationTypesResponse = await IdentificationTypeService.GetIdentificationTypesAsync();
        identificationTypes = identificationTypesResponse?.Data?.ToList() ?? [];

        // Reuse the tenant list the TenantSwitcher already loaded: it already filters down to the
        // caller's accessible tenants (master admins see all, tenant admins see only their own).
        tenants = TenantContext.Tenants.Count > 0
            ? TenantContext.Tenants.ToList()
            : (await TenantService.GetTenantsAsync())?.Data?.ToList() ?? [];

        var rolesResponse = await RoleService.GetRolesAsync(new PagedRequest { PageSize = 1000 });
        roles = rolesResponse?.Data?.Items?.ToList() ?? [];

        var response = await UserService.GetUsersAsync();
        item = response?.Data?.FirstOrDefault(u => u.Id == Id);
        if (item is null) return;

        // Inner join: only the catalogue roles (`roles`) that also appear in this
        // user's assignments (`item.Roles`) survive - RoleModel.Id (Guid) against
        // UserRoleModel.RoleId (Guid?), so the outer key is cast to match.
        assignedRoles = [.. roles.Join(
            item.Roles,
            role => (Guid?)role.Id,
            userRole => userRole.RoleId,
            (role, _) => role)];

        name = item.Name ?? string.Empty;
        middleName = item.MiddleName ?? string.Empty;
        lastName = item.LastName ?? string.Empty;
        userName = item.UserName ?? string.Empty;
        email = item.Email ?? string.Empty;
        identification = item.Identification ?? string.Empty;
        password = "**********";
        isActive = item.IsActive;
        selectedIdentificationType = identificationTypes.FirstOrDefault(t => t.Id == item.IdentificationTypeId);
        selectedTenant = tenants.FirstOrDefault(t => t.Id == item.TenantId);
    }

    private async Task SaveAsync()
    {
        if (selectedIdentificationType is null || selectedTenant is null) return;

        saving = true;
        var request = new UpdateUserRequest(
            name, middleName, lastName, userName, email, password, identification,
            selectedIdentificationType.Id, selectedTenant.Id);

        var response = await UserService.UpdateUserAsync(Id, request);

        if (response.IsSuccessStatusCode && item is not null)
        {
            if (isActive && !item.IsActive)
            {
                await UserService.ActivateUserAsync(Id);
            }
            else if (!isActive && item.IsActive)
            {
                await UserService.DeactivateUserAsync(Id);
            }
        }

        if (response.IsSuccessStatusCode)
        {
            password = "**********";
            // refresh local item state so toggle logic stays consistent
            var refreshed = await UserService.GetUserByIdAsync(Id);
            if (refreshed?.Data is not null) item = refreshed.Data;
        }

        saving = false;

        if (response.IsSuccessStatusCode)
            ToastService.ShowSuccess(L["SavedToast"]);
        else
            ToastService.ShowError(L["SaveFailedToast", (int)response.StatusCode]);
    }

    private Task AddRoleAsync()
    {
        if (!Guid.TryParse(roleIdToAdd, out var roleId)) return Task.CompletedTask;

        roleIdToAdd = string.Empty;
        return SyncRolesAsync([.. assignedRoles.Select(r => r.Id), roleId]);
    }

    private Task RemoveRoleAsync(Guid roleId) =>
        SyncRolesAsync(assignedRoles.Where(r => r.Id != roleId).Select(r => r.Id));

    /// <summary>
    /// AssignRolesToUserCommand replaces the user's full role set, so every add/remove
    /// sends the complete desired list, then reloads the page to reflect what was saved
    /// (rather than trusting optimistic local state).
    /// </summary>
    private async Task SyncRolesAsync(IEnumerable<Guid> roleIds)
    {
        savingRoles = true;

        var response = await UserService.AssignRolesToUserAsync(Id, new AssignRolesRequest([.. roleIds]));

        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["RolesSavedToast"]);
            var r = await UserService.GetUserByIdAsync(Id);
            if (r?.Data is not null)
            {
                item = r.Data;
                assignedRoles = [.. (roles ?? []).Join(
                    item.Roles,
                    role => (Guid?)role.Id,
                    userRole => userRole.RoleId,
                    (role, _) => role)];
            }
            savingRoles = false;
        }
        else
        {
            savingRoles = false;
            ToastService.ShowError(L["RolesSaveFailedToast", (int)response.StatusCode]);
        }
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteUserConfirm", userName],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await UserService.DeleteUserAsync(Id);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["UserDeletedToast"]);
            Nav.NavigateTo("/users");
        }
        else
        {
            ToastService.ShowError(L["UserDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
