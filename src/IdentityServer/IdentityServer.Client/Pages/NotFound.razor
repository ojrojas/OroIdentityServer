@page "/not-found"
@layout NotFoundLayout
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["NotFoundTitle"]</PageTitle>

<section class="card">
    <div class="empty">
        <p class="empty-title">@L["NotFoundTitle"]</p>
        <p>@L["NotFoundMessage"]</p>
        <a class="btn btn-primary" href="/">
            <Icon Name="dashboard" Size="15" /> @L["NavDashboard"]
        </a>
    </div>
</section>
