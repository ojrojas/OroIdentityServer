@page "/applications/{ClientId}"
@attribute [Authorize(Roles = "Admin")]
@inject IAdminApplicationService ApplicationService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IToastService ToastService
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ApplicationDetailTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["ApplicationDetailTitle"]</h2>
    </div>

    @if (item is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else
    {
        <div class="form form-wide">
            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="clientId">@L["ClientId"]</label>
                    <input id="clientId" class="input" value="@ClientId" readonly />
                </div>
                <div class="field">
                    <label class="field-label" for="displayName">@L["DisplayName"]</label>
                    <input id="displayName" class="input" @bind="displayName" @bind:event="oninput" />
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="clientSecret">@L["ClientSecret"]</label>
                    <input id="clientSecret" type="password" class="input" placeholder="@L["ClientSecretEditPlaceholder"]" @bind="clientSecret" @bind:event="oninput" />
                </div>
                <div class="field">
                    <label class="field-label" for="clientType">@L["ClientType"]</label>
                    <select id="clientType" class="select" @bind="clientType">
                        <option value="confidential">confidential</option>
                        <option value="public">public</option>
                    </select>
                </div>
            </div>

            <div class="form-grid">
                <div class="field">
                    <label class="field-label" for="consentType">@L["ConsentType"]</label>
                    <select id="consentType" class="select" @bind="consentType">
                        <option value="explicit">explicit</option>
                        <option value="implicit">implicit</option>
                        <option value="external">external</option>
                        <option value="system">system</option>
                    </select>
                </div>
                <div class="field">
                    <label class="field-label">@L["ApplicationPermissions"]</label>
                    <span class="field-hint">@L["ApplicationPermissionsHint"]</span>
                </div>
            </div>

            <div class="field">
                <label class="field-label">@L["RedirectUris"]</label>
                <TagInput @bind-Values="redirectUris" />
            </div>

            <div class="field">
                <label class="field-label">@L["PostLogoutRedirectUris"]</label>
                <TagInput @bind-Values="postLogoutRedirectUris" />
            </div>

            <PermissionChecklist Title="@L["Endpoints"]" Options="OpenIddictPermissionOptions.Endpoints" Selected="permissions" SelectedChanged="@(() => { })" />
            <PermissionChecklist Title="@L["GrantTypes"]" Options="OpenIddictPermissionOptions.GrantTypes" Selected="permissions" SelectedChanged="@(() => { })" />
            <PermissionChecklist Title="@L["ResponseTypes"]" Options="OpenIddictPermissionOptions.ResponseTypes" Selected="permissions" SelectedChanged="@(() => { })" />
            <PermissionChecklist Title="@L["ScopesPermissions"]" Options="OpenIddictPermissionOptions.Scopes" Selected="permissions" SelectedChanged="@(() => { })" />
            <PermissionChecklist Title="@L["Requirements"]" Options="OpenIddictPermissionOptions.Requirements" Selected="requirements" SelectedChanged="@(() => { })" />

            <div class="field">
                <label class="field-label">@L["AdditionalScopes"]</label>
                <span class="field-hint">@L["AdditionalScopesHint"]</span>
                <TagInput @bind-Values="customScopes" InputType="text" Placeholder="tenant" />
            </div>

            <div class="form-actions">
                <button type="button" class="btn btn-primary" disabled="@saving" @onclick="SaveAsync">@L["Save"]</button>
                <button type="button" class="btn btn-ghost" @onclick='() => Nav.NavigateTo("/applications")'>@L["Back"]</button>
                <div class="spacer"></div>
                <button type="button" class="btn btn-danger" @onclick="DeleteAsync">
                    <Icon Name="trash" Size="15" /> @L["Delete"]
                </button>
            </div>
        </div>
    }
</section>

@code {
    [Parameter]
    public string ClientId { get; set; } = string.Empty;

    private OpenIddictApplicationModel? item;
    private string displayName = string.Empty;
    private string clientSecret = string.Empty;
    private string clientType = "confidential";
    private string consentType = "explicit";
    private HashSet<string> permissions = new(StringComparer.Ordinal);
    private HashSet<string> requirements = new(StringComparer.Ordinal);
    private List<string> customScopes = [];
    private List<string> redirectUris = [];
    private List<string> postLogoutRedirectUris = [];
    private bool saving;

    protected override async Task OnInitializedAsync()
    {
        item = await ApplicationService.GetApplicationByClientIdAsync(ClientId);
        if (item is null) return;

        displayName = item.DisplayName ?? string.Empty;
        clientType = item.ClientType ?? "confidential";
        consentType = item.ConsentType ?? "explicit";
        redirectUris = item.RedirectUris?.ToList() ?? [];
        postLogoutRedirectUris = item.PostLogoutRedirectUris?.ToList() ?? [];

        permissions = new HashSet<string>(item.Permissions ?? [], StringComparer.Ordinal);
        requirements = new HashSet<string>(item.Requirements ?? [], StringComparer.Ordinal);
        customScopes = [.. OpenIddictPermissionOptions.CustomScopeNames(permissions)];
        foreach (var scope in customScopes)
            permissions.Remove($"scp:{scope}");
    }

    private async Task SaveAsync()
    {
        saving = true;
        var allPermissions = permissions
            .Concat(customScopes.Select(s => $"scp:{s}"))
            .Distinct(StringComparer.Ordinal)
            .ToList();

        var model = new OpenIddictApplicationModel(
            ClientId, string.IsNullOrWhiteSpace(clientSecret) ? item!.ClientSecret : clientSecret, displayName, clientType,
            item!.ApplicationType, consentType, allPermissions, [.. requirements], redirectUris, postLogoutRedirectUris);

        var response = await ApplicationService.UpdateApplicationAsync(ClientId, model);
        saving = false;

        if (response.IsSuccessStatusCode)
            ToastService.ShowSuccess(L["SavedToast"]);
        else
            ToastService.ShowError(L["SaveFailedToast", (int)response.StatusCode]);
    }

    private async Task DeleteAsync()
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteApplicationConfirm", ClientId],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await ApplicationService.DeleteApplicationAsync(ClientId);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["ApplicationDeletedToast"]);
            Nav.NavigateTo("/applications");
        }
        else
        {
            ToastService.ShowError(L["ApplicationDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
