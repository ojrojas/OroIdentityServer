@page "/applications"
@attribute [Authorize(Roles = "Admin,Administrator")]
@inject IAdminApplicationService ApplicationService
@inject IDialogService DialogService
@inject IToastService ToastService
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>@L["ApplicationsTitle"]</PageTitle>

<section class="card">
    <div class="card-head">
        <h2 class="card-title">@L["ApplicationsTitle"]</h2>
        <button type="button" class="btn btn-primary btn-sm" @onclick="CreateAsync">
            <Icon Name="plus" Size="15" Stroke="2.2" /> @L["New"]
        </button>
    </div>

    <div class="card-search">
        <input class="input" placeholder="@L["Search"]" @bind="searchTerm" @bind:event="oninput" @onkeydown="SearchKeyDown" />
    </div>

    @if (items is null)
    {
        <div class="spinner spinner-lg spinner-center"></div>
    }
    else if (items.Count == 0)
    {
        <div class="empty">
            <p class="empty-title">@L["NoData"]</p>
            <p>@L["NoDataHint"]</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>@L["ClientId"]</th>
                        <th>@L["ColDisplayName"]</th>
                        <th>@L["ColType"]</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        <tr>
                            <td class="cell-strong">@item.ClientId</td>
                            <td>@item.DisplayName</td>
                            <td class="cell-muted">@item.ClientType</td>
                            <td>
                                <div class="actions">
                                    <button type="button" class="btn-row" title="@L["Edit"]" @onclick="@(() => Nav.NavigateTo($"/applications/{item.ClientId}"))">
                                        <Icon Name="edit" Size="15" />
                                    </button>
                                    <button type="button" class="btn-row is-danger" title="@L["Delete"]" @onclick="@(() => DeleteAsync(item))">
                                        <Icon Name="trash" Size="15" />
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <Pagination PageNumber="@pageNumber" TotalPages="@totalPages" TotalCount="@totalCount"
                    PageSize="@pageSize" PageNumberChanged="OnPageNumberChanged" PageSizeChanged="OnPageSizeChanged" />
    }
</section>

@code {
    private List<OpenIddictApplicationModel>? items;
    private string searchTerm = string.Empty;
    private int pageNumber = 1;
    private int pageSize = 20;
    private int totalCount;
    private int totalPages;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        var response = await ApplicationService.GetApplicationsAsync(new PagedRequest
        {
            SearchTerm = searchTerm,
            PageNumber = pageNumber,
            PageSize = pageSize
        });
        items = response?.Items?.ToList() ?? [];
        totalCount = response?.TotalCount ?? 0;
        totalPages = (int)Math.Ceiling((double)totalCount / pageSize);
    }

    private async Task SearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            pageNumber = 1;
            await LoadAsync();
        }
    }

    private async Task OnPageNumberChanged(int page)
    {
        pageNumber = page;
        await LoadAsync();
    }

    private async Task OnPageSizeChanged(int size)
    {
        pageSize = size;
        pageNumber = 1;
        await LoadAsync();
    }

    private void CreateAsync() => Nav.NavigateTo("/applications/create");

    private async Task DeleteAsync(OpenIddictApplicationModel item)
    {
        var ok = await DialogService.ConfirmAsync(
            L["ConfirmDeletionTitle"], L["DeleteApplicationConfirm", item.ClientId ?? string.Empty],
            L["Delete"], L["Cancel"], danger: true);
        if (!ok) return;

        var response = await ApplicationService.DeleteApplicationAsync(item.ClientId!);
        if (response.IsSuccessStatusCode)
        {
            ToastService.ShowSuccess(L["ApplicationDeletedToast"]);
            await LoadAsync();
        }
        else
        {
            ToastService.ShowError(L["ApplicationDeleteFailedToast", (int)response.StatusCode]);
        }
    }
}
