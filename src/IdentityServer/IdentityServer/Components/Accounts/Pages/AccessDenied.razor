@page "/access-denied"
@layout LoginLayout
@inject IStringLocalizer<SharedResources> L

<div class="auth">
    <div class="auth-card">
        <div class="auth-head">
            <span class="auth-mark">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="11" width="18" height="11" rx="2" />
                    <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
            </span>
            <h1 class="auth-title">@L["AccessDeniedTitle"]</h1>
            <p class="auth-sub">@L["AccessDeniedMessage"]</p>
        </div>

        <div class="auth-form">
            <a class="btn btn-primary btn-block" href="/auth/logout">@L["AccessDeniedSignOut"]</a>
        </div>

        <div class="auth-foot">@L["AdminPanel"]</div>
    </div>
</div>
