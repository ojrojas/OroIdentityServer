@page "/Account/ChangePassword"
@layout LoginLayout
@attribute [Authorize]
@inject IStringLocalizer<SharedResources> L

<div class="auth">
    <div class="auth-card">
        <div class="auth-head">
            <span class="auth-mark">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="4" y="10" width="16" height="11" rx="2" />
                    <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                    <path d="M12 15v2" />
                </svg>
            </span>
            <h1 class="auth-title">@L["ChangePasswordTitle"]</h1>
            <p class="auth-sub">@L["ChangePasswordSubtitle"]</p>
        </div>

        @if (Error == "mismatch")
        {
            <div class="alert alert-error">@L["PasswordMismatch"]</div>
        }

        <form action="/auth/change-password" method="post" class="auth-form">
            <div class="field">
                <label class="field-label" for="newPassword">@L["NewPasswordPlaceholder"]</label>
                <input id="newPassword"
                       name="NewPassword"
                       class="input"
                       type="password"
                       autocomplete="new-password"
                       required
                       autofocus />
            </div>

            <div class="field">
                <label class="field-label" for="confirmPassword">@L["ConfirmNewPasswordPlaceholder"]</label>
                <input id="confirmPassword"
                       name="ConfirmPassword"
                       class="input"
                       type="password"
                       autocomplete="new-password"
                       required />
            </div>

            <button type="submit" class="btn btn-primary btn-block">@L["ChangePasswordButton"]</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
}
